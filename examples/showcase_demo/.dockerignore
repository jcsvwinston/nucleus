# The build context is everything `docker build` uploads to the daemon and
# everything a `COPY .` can pull into an image. Keeping it small is a speed
# question; keeping these entries out of it is not.
#
# .git carries every value ever committed, including the ones that were
# removed in a later commit. A local .env and a SQLite file carry the
# credentials and the data of the machine that built the image.
.git
.gitignore
.env
.env.*
*.db
*.db-journal
*.log

# The Dockerfile does not build itself, and the compiled binary is rebuilt
# inside the image — a host binary in the context is a different platform's.
Dockerfile
.dockerignore
/showcase_demo
bin/
dist/
