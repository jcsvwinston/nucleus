database_default: default
databases:
  default:
    url: {{.DatabaseURL}}
    max_open: 25
    max_idle: 5
    max_lifetime: 5m
host: 0.0.0.0
port: {{.Port}}
env: development
log_level: info
log_format: text
# Allowed CORS origins. Empty/unset DENIES all cross-origin requests
# (security-by-default) — add an explicit allow-list to enable CORS.
# cors_origins: ["https://example.com"]  # empty = deny cross-origin; use ["*"] for the historical allow-all
# cors_allow_credentials: false
# Trusted upstream proxies whose X-Forwarded-For / X-Real-IP are honored.
# Empty (default) ignores those headers and uses the peer address as client IP.
# trusted_proxies: ["10.0.0.0/8"]  # set to your load balancer / reverse proxy
# CSRF stays off for the API scaffold: a Bearer-token API is not CSRF-forgeable.
# Turn it on if you add session-cookie (browser) routes to this app.
# csrf_enabled: true
# csrf_exempt_paths: ["/api/"]
# Per-client request budget, enforced by WithRateLimit() in main.go; 0 or
# unset is no limit. Turn it on before the service faces the internet.
# rate_limit_requests: 100
# rate_limit_window: 1m
# Path to the Casbin RBAC CSV policy file the default-deny enforcer
# WithAuthz() mounts in main.go loads; a generated module brings its own rows.
rbac_policy_file: rbac_policy.csv
# /metrics, when the Prometheus exporter is linked, answers without auth by
# default; metrics_public: false keeps it behind the enforcer, so grant it to
# your scraper in rbac_policy.csv.
# metrics_public: false
# The profiler sits behind the enforcer too: turn it on when an on-call
# engineer needs a profile, and grant /debug/pprof/* to that role, never to
# anonymous.
# profiling_enabled: false
