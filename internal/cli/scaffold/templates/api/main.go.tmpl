// Command {{.ProjectName}} is the entry point for your Nucleus application —
// a thin fluent composition root. This starter is an empty skeleton: add
// features by writing modules and mounting them, e.g.
//
//	nucleus.New().
//	    FromConfigFile("nucleus.yml").
//	    WithoutDefaults().
//	    WithStorage().
//	    Mount(notes.Module()).   // your module
//	    Start()
//
// See the documentation's quickstart for a worked module (model + REST
// Resource controller + migrations).
package main

import (
	"log"
{{- if .Has "orbit"}}
	"os"
{{- end}}

	"github.com/jcsvwinston/nucleus/pkg/nucleus"
{{- if .Has "orbit"}}
	"github.com/jcsvwinston/orbit"
{{- end}}

	// The database driver is linked by importing it, the way database/sql
	// drivers have always been wired. nucleus.yml starts you on
	// {{.Database}} (databases.default.url), so this is the driver that
	// matches it; switch the URL to another engine and swap this line for
	// its driver module — or run `nucleus add postgres`, which does the
	// go get and rewrites this import for you.
	//
	// Each engine ships as its own module so an application links only the
	// one it uses. If you change the URL and forget the import, the app
	// refuses to start and the error names the line to add.
	_ "{{.DriverModule}}"
)

func main() {
	// WithoutDefaults() builds a lightweight core-only app (config, logger,
	// router, DB, sessions) — no admin panel, mail or authz, and storage and
	// rate limiting only when nucleus.yml asks for them (WithStorage and
	// WithRateLimit below). With no modules mounted yet it serves only the
	// framework's built-in endpoints (e.g. /healthz). Mount your first
	// module to add routes.
	if err := nucleus.New().
		FromConfigFile("nucleus.yml").
		// The application's OpenAPI document, derived from the routes its
		// modules register and the security it enforces, served at
		// /openapi.json (`nucleus openapi` exports the same document). A
		// project with a hand-written internal/contracts passes it as the
		// base: WithOpenAPIDocument("/openapi.json", contracts.NewDocument()).
		WithOpenAPIDocument("/openapi.json").
		WithoutDefaults().
		// Storage is built when nucleus.yml writes a storage block and not
		// before: `nucleus add s3` (or gcs, azure) and `storage.provider: s3`
		// give the app its bucket. Without this line a storage block is
		// ignored, with an ERROR line at boot that names it.
		WithStorage().
		// The rate limiter is mounted when nucleus.yml sets
		// rate_limit_requests above 0, and not before. Without this line the
		// rate_limit_* keys are ignored, with an ERROR line at boot.
		WithRateLimit().
{{- if .Has "orbit"}}
		Mount(orbit.Module(orbit.Config{
			Prefix: "/admin",
			Title:  "{{.ProjectName}}",

			// The first admin account, created on first boot when the
			// admin_users table is empty. The password comes from the
			// environment; the fallback is a development credential for a
			// laptop, never for a network.
			BootstrapUsername: "admin",
			BootstrapEmail:    "admin@example.com",
			BootstrapPassword: bootstrapPassword(),
		})).
{{- end}}
		Start(); err != nil {
		log.Fatalf("{{.ProjectName}}: %v", err)
	}
}
{{- if .Has "orbit"}}

// bootstrapPassword is ADMIN_BOOTSTRAP_PASSWORD, or "quickstart" when the
// variable is unset — the credential the docs log in with. Set the variable
// before the app faces anyone but you.
func bootstrapPassword() string {
	if p := os.Getenv("ADMIN_BOOTSTRAP_PASSWORD"); p != "" {
		return p
	}
	return "quickstart"
}
{{- end}}
