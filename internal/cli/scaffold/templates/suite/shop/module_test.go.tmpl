package shop_test

import (
	"context"
	"net/http"
{{- if eq .Database "sqlite"}}
	"path/filepath"
{{- else}}
	"os"
{{- end}}
	"testing"

	"github.com/jcsvwinston/nucleus/pkg/app"
	"github.com/jcsvwinston/nucleus/pkg/nucleus"
	"github.com/jcsvwinston/nucleus/pkg/nucleustest"
	"github.com/jcsvwinston/quark"

	"{{.Module}}/shop"

	// The test boots a real application, so the test binary links the
	// driver modules the way main.go does — the duplicate-title probe below
	// only answers 409 when Quark's classifier is registered.
	_ "{{.DriverModule}}"
	_ "{{.QuarkDriverModule}}"
)

// TestShopServesArticlesThroughQuark mounts the module on an in-process
// application and drives it through the test kit's client: Quark migrates
// and seeds the schema, the module's own policy rows and CSRF exemption are
// in force, the JSON API lists and creates, and a duplicate title answers
// 409. Nothing here is faked — it is the same boot path main.go runs, and
// the answers are decoded into the module's own types.
func TestShopServesArticlesThroughQuark(t *testing.T) {
	if testing.Short() {
		t.Skip("boots an in-process application; skipped with -short")
	}
	ctx := context.Background()

	databases, driver, dsn := testDatabases(t)
	client, err := quark.New(driver, dsn)
	if err != nil {
		t.Fatalf("quark client: %v", err)
	}
	defer client.Close()
	if err := shop.Migrate(ctx, client); err != nil {
		t.Fatalf("migrate/seed: %v", err)
	}

	srv := nucleustest.Start(t, nucleus.New().
		WithDatabases(databases).
		Mount(shop.Module(client)))

	if titles := listTitles(t, srv); !titles["Hello, Quantum"] {
		t.Errorf("GET /api/articles: want the seeded article, got %v", titles)
	}

	// The module's create row lets an anonymous caller POST (a development
	// default; see the Policies in module.go) and /api/ is CSRF-exempt, so
	// the write lands without a token.
	probe := map[string]any{"author_id": 1, "title": "probe", "body": "from the test"}
	resp := srv.Post("/api/articles", probe)
	if resp.Status != http.StatusCreated {
		t.Fatalf("POST /api/articles: want %d, got %d: %s", http.StatusCreated, resp.Status, resp)
	}
	var created shop.Article
	resp.JSON(t, &created)
	if created.ID == 0 || created.Title != "probe" || created.AuthorID != 1 {
		t.Errorf("POST /api/articles: want the created article echoed with its key, got %+v", created)
	}

	if dup := srv.Post("/api/articles", probe); dup.Status != http.StatusConflict {
		t.Errorf("POST /api/articles with a duplicate title: want %d, got %d: %s", http.StatusConflict, dup.Status, dup)
	}

	if titles := listTitles(t, srv); !titles["probe"] {
		t.Errorf("GET /api/articles after the POST: want the new article listed, got %v", titles)
	}
}

// listTitles reads GET /api/articles into the module's Article type and
// returns the titles it lists.
func listTitles(t *testing.T, srv *nucleustest.Server) map[string]bool {
	t.Helper()
	resp := srv.Get("/api/articles")
	if resp.Status != http.StatusOK {
		t.Fatalf("GET /api/articles: want %d, got %d: %s", http.StatusOK, resp.Status, resp)
	}
	var list struct {
		Articles []shop.Article `json:"articles"`
		Count    int            `json:"count"`
	}
	resp.JSON(t, &list)
	if list.Count != len(list.Articles) {
		t.Errorf("GET /api/articles: count %d for %d articles", list.Count, len(list.Articles))
	}
	titles := make(map[string]bool, len(list.Articles))
	for _, a := range list.Articles {
		titles[a.Title] = true
	}
	return titles
}
{{- if eq .Database "sqlite"}}

// testDatabases gives the application and Quark one temporary SQLite file
// each test, the way main.go shares app.db between them.
func testDatabases(t *testing.T) (map[string]app.DatabaseConfig, string, string) {
	t.Helper()
	file := filepath.Join(t.TempDir(), "shop_test.db")
	return map[string]app.DatabaseConfig{"default": {URL: "sqlite://" + file}}, "sqlite", file
}
{{- else}}

// testDatabases points the test at a {{.Database}} database, the engine the
// project was scaffolded on: NUCLEUS_TEST_DATABASE_URL for the application
// (the databases.default.url shape) and QUARK_TEST_DSN for the Quark client
// (what quark.New takes). The test skips when either is unset — never
// silently green.
func testDatabases(t *testing.T) (map[string]app.DatabaseConfig, string, string) {
	t.Helper()
	url, dsn := os.Getenv("NUCLEUS_TEST_DATABASE_URL"), os.Getenv("QUARK_TEST_DSN")
	if url == "" || dsn == "" {
		t.Skip("set NUCLEUS_TEST_DATABASE_URL and QUARK_TEST_DSN to a {{.Database}} database to run this test")
	}
	return map[string]app.DatabaseConfig{"default": {URL: url}}, "{{.QuarkDriver}}", dsn
}
{{- end}}
