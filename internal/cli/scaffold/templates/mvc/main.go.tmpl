// features by writing modules and mounting them, e.g.
//
//	nucleus.New().
//	    FromConfigFile("nucleus.yml").
//	    Mount(notes.Module()).   // your module
//	    Start()
//
// See the documentation and the examples/mvc_api reference app for a worked
// module (model + REST Resource controller + migrations).
package main

import (
	"log"

	"github.com/jcsvwinston/nucleus/pkg/nucleus"

	// The database driver is linked by importing it, the way database/sql
	// drivers have always been wired. nucleus.yml starts you on
	// sqlite://app.db, so this is the driver that matches it; switch the URL
	// to postgres:// or mysql:// and swap this line for
	// drivers/postgres or drivers/mysql — or run `nucleus add postgres`,
	// which does the go get and rewrites this import for you.
	//
	// Each engine ships as its own module so an application links only the
	// one it uses. If you change the URL and forget the import, the app
	// refuses to start and the error names the line to add.
	_ "github.com/jcsvwinston/nucleus/drivers/sqlite"
)

func main() {
	// Full app (no WithoutDefaults): a default-deny Casbin enforcer is active.
	// rbac_policy.csv (referenced by rbac_policy_file in nucleus.yml) grants
	// anonymous access to the public framework endpoints; widen it as you add
	// your own routes. The admin panel is not in the core — to add one, pull in
	// github.com/jcsvwinston/orbit and Mount(orbit.Module(...)). With no modules
	// mounted yet, the app serves the built-in framework endpoints and /healthz.
	if err := nucleus.New().
		FromConfigFile("nucleus.yml").
		Start(); err != nil {
		log.Fatalf("{{.ProjectName}}: %v", err)
	}
}
