// Command {{.ProjectName}} is the entry point for your Nucleus application —
// a thin fluent composition root. This starter is an empty skeleton: add
// features by writing modules and mounting them, e.g.
//
//	nucleus.New().
//	    FromConfigFile("nucleus.yml").
//	    Mount(notes.Module()).   // your module
//	    Start()
//
// See the documentation's quickstart for a worked module (model + REST
// Resource controller + migrations).
package main

import (
{{- if .Has "orbit"}}
	"context"
	"errors"
{{- end}}
	"log"
{{- if .Has "orbit"}}
	"os"
	"sync"
{{- end}}

	"github.com/jcsvwinston/nucleus/pkg/nucleus"
{{- if .Has "orbit"}}
	"github.com/jcsvwinston/orbit"
	"github.com/jcsvwinston/orbit/quarkdatasource"
	"github.com/jcsvwinston/quark"
{{- end}}

	// The database driver is linked by importing it, the way database/sql
	// drivers have always been wired. nucleus.yml starts you on
	// {{.Database}} (databases.default.url), so this is the driver that
	// matches it; switch the URL to another engine and swap this line for
	// its driver module — or run `nucleus add postgres`, which does the
	// go get and rewrites this import for you.
	//
	// Each engine ships as its own module so an application links only the
	// one it uses. If you change the URL and forget the import, the app
	// refuses to start and the error names the line to add.
	_ "{{.DriverModule}}"
{{- if .Has "orbit"}}
	// Quark's driver module for the same engine registers the error
	// classifier (duplicate key, deadlock) behind the statements Data
	// Studio runs. Swap it together with the line above when you change
	// engines; without it the app boots and those errors stay generic.
	_ "{{.QuarkDriverModule}}"
{{- end}}
)

func main() {
	// Full app (no WithoutDefaults): a default-deny Casbin enforcer is active.
	// rbac_policy.csv (referenced by rbac_policy_file in nucleus.yml) grants
	// anonymous access to the public framework endpoints; widen it as you add
	// your own routes.
{{- if .Has "orbit"}}
	// The admin panel is the orbit module mounted under /admin below; it
	// brings its own login gate and needs no policy rows. Beyond it, the app
	// serves the built-in framework endpoints and /healthz.
	//
	// Data Studio speaks Orbit's datasource contract; back it with Quark over
	// the pool the framework opens from nucleus.yml (quarkPool, below). The
	// panel starts with nothing to browse: register each Quark model your
	// modules add — `nucleus generate resource` and `nucleus startapp` write
	// Quark models in internal/models, so they register as they are:
	//
	//	if err := quarkdatasource.Register[models.Note](ds); err != nil {
	//		log.Fatalf("{{.ProjectName}}: register Note: %v", err)
	//	}
	pool := &quarkPool{}
	ds := quarkdatasource.New(pool)
{{else}}
	// The admin panel is not in the core — to add one, pull in
	// github.com/jcsvwinston/orbit and Mount(orbit.Module(...)). With no modules
	// mounted yet, the app serves the built-in framework endpoints and /healthz.
{{- end}}
	if err := nucleus.New().
		FromConfigFile("nucleus.yml").
		// The application's OpenAPI document, derived from the routes its
		// modules register and the security it enforces, served at
		// /openapi.json (`nucleus openapi` exports the same document). A
		// project with a hand-written internal/contracts passes it as the
		// base: WithOpenAPIDocument("/openapi.json", contracts.NewDocument()).
		WithOpenAPIDocument("/openapi.json").
{{- if .Has "orbit"}}
		Mount(pool.Module()).
		Mount(orbit.Module(orbit.Config{
			Prefix:     "/admin",
			Title:      "{{.ProjectName}}",
			DataSource: ds,

			// The first admin account, created on first boot when the
			// admin_users table is empty. The password comes from the
			// environment; the fallback is a development credential for a
			// laptop, never for a network.
			BootstrapUsername: "admin",
			BootstrapEmail:    "admin@example.com",
			BootstrapPassword: bootstrapPassword(),
		})).
{{- end}}
		Start(); err != nil {
		log.Fatalf("{{.ProjectName}}: %v", err)
	}
}
{{- if .Has "orbit"}}

// quarkPool is the quark.ClientProvider Data Studio queries through. The
// framework owns the database pool — opened from nucleus.yml when the
// application starts, closed when it stops — so the Quark client is derived
// from that pool in the OnStart hook of the module below (quark.NewWithDB
// borrows the *sql.DB, the way `nucleus generate module --data quark`
// does) rather than opened as a second connection with its own DSN. The
// driver name tells Quark which dialect to speak; it matches the
// {{.Database}} URL nucleus.yml starts with — change both when you move to
// another engine.
type quarkPool struct {
	mu     sync.RWMutex
	client *quark.Client
}

// Module is the hook that derives the client once the pool is open. The
// adapter asks for the client per request, after every module has started,
// so the order the modules are mounted in does not matter.
func (p *quarkPool) Module() nucleus.ModuleSpec {
	return nucleus.Module[struct{}]{
		Name: "quark",
		OnStart: func(_ context.Context, rt nucleus.Runtime, _ struct{}) error {
			db := rt.DB()
			if db == nil {
				return errors.New("quark: no managed database configured (set databases.default.url in nucleus.yml)")
			}
			client, err := quark.NewWithDB("{{.QuarkDriver}}", db)
			if err != nil {
				return err
			}
			p.mu.Lock()
			p.client = client
			p.mu.Unlock()
			return nil
		},
	}.Build()
}

// GetClient implements quark.ClientProvider for the Data Studio adapter.
func (p *quarkPool) GetClient(context.Context) (*quark.Client, error) {
	p.mu.RLock()
	defer p.mu.RUnlock()
	if p.client == nil {
		return nil, errors.New("quark: the client is derived when the application starts")
	}
	return p.client, nil
}

// bootstrapPassword is ADMIN_BOOTSTRAP_PASSWORD, or "quickstart" when the
// variable is unset — the credential the docs log in with. Set the variable
// before the app faces anyone but you.
func bootstrapPassword() string {
	if p := os.Getenv("ADMIN_BOOTSTRAP_PASSWORD"); p != "" {
		return p
	}
	return "quickstart"
}
{{- end}}
