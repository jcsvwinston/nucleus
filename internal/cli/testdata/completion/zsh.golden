#compdef nucleus
# nucleus zsh completion, generated by `nucleus completion zsh`. Do not edit: regenerate after upgrading the CLI.

_nucleus() {
    local -a commands
    commands=(
        'add:Add an optional module (database driver, storage provider, auth backend) and its blank import'
        'changepassword:Update an admin user'\''s password'
        'check:Alias of health'
        'clearsessions:Delete expired or all session rows'
        'collectstatic:Collect static assets into configured static_root'
        'compilemessages:Compile .po message catalogs into JSON bundles'
        'completion:Print a shell completion script (bash, zsh, fish)'
        'config:Print the effective configuration with per-key source (usage - config print)'
        'createcachetable:Create SQL table used by database-backed cache'
        'createsuperuser:Alias of createuser'
        'createuser:Create or update an admin user'
        'dbshell:Alias of shell'
        'dev:Build, run and restart your application on every change'
        'diffsettings:Show configuration differences from defaults'
        'doctor:Run diagnostic checks for framework subsystems'
        'dumpdata:Export DB rows as JSON fixtures'
        'findstatic:Find static assets across discovered source directories'
        'flush:Delete all data from database tables (keeps migration history)'
        'generate:Generate model, handler, or migration scaffolds'
        'health:Check configured dependencies health'
        'help:Print the help of a command'
        'inspectdb:Inspect DB schema and generate Go model structs'
        'loaddata:Import JSON fixtures into DB tables'
        'mailproviders:List registered and external mail providers'
        'makemessages:Extract translatable strings into .po catalogs'
        'makemigrations:Alias of migrate create <name>'
        'migrate:Apply and manage SQL migrations'
        'new:Create a new MVC + API project scaffold'
        'ogrinspect:Inspect geospatial tables and generate Go model structs'
        'openapi:Export the experimental OpenAPI project contract'
        'optimizemigration:Optimize SQL statements in one migration file'
        'outbox:Inspect and manage transactional outbox messages'
        'plugin:Inspect and validate plugin providers/capabilities'
        'remove_stale_contenttypes:Delete stale rows from content types table'
        'routes:List registered HTTP routes'
        'runserver:Alias of serve (addr -port)'
        'seed:Execute SQL seed files'
        'sendtestemail:Send a test email through configured mail provider'
        'serve:Start the HTTP server'
        'shell:Execute SQL interactively or via -c'
        'showmigrations:Alias of migrate status'
        'sqlflush:Print SQL statements used by flush'
        'sqlmigrate:Print SQL for a migration file'
        'sqlsequencereset:Print SQL statements to reset table sequences'
        'squashmigrations:Squash a migration range into a single migration'
        'startapp:Create an app scaffold in an existing project'
        'startproject:Alias of new'
        'test:Run Go tests with project-friendly defaults'
        'testserver:Load fixture data and start a local server'
        'version:Print the CLI version'
        'wizard:Experimental prompt front-end; explains the canonical command, executes nothing'
    )
    local curcontext="$curcontext" state line
    typeset -A opt_args

    _arguments -C \
        '--output[Output style]:value:(plain pretty json)' \
        '--color[Color mode]:value:(auto always never)' \
        '--symbols[Print status symbols]' \
        '--no-symbols[Do not print status symbols]' \
        '--json[Shorthand for --output json]' \
        '1:command:->command' \
        '*::argument:->arguments'

    case "$state" in
        command)
            _describe -t commands 'nucleus command' commands
            ;;
        arguments)
            case "${words[1]}" in
                add)
                    _files
                    ;;
                changepassword)
                    _arguments \
                        '--config[Path to nucleus config file]:file:_files' \
                        '--database[Database alias to use (defaults to database_default)]:value:' \
                        '--no-input[Disable interactive prompts]' \
                        '--password[New password (plaintext)]:value:' \
                        '--username[Username to update]:value:' \
                        '*:argument:_files'
                    ;;
                check)
                    _arguments \
                        '--config[Path to nucleus config file]:file:_files' \
                        '--deploy[Run additional deployment hardening checks]' \
                        '--json[Print output as JSON]' \
                        '--timeout[Health check timeout (default 3s)]:value:' \
                        '*:argument:_files'
                    ;;
                clearsessions)
                    _arguments \
                        '--all[Delete all sessions instead of only expired sessions]' \
                        '--config[Path to nucleus config file]:file:_files' \
                        '--database[Database alias to use (defaults to database_default)]:value:' \
                        '--dry-run[Print SQL and exit without executing]' \
                        '--table[Sessions table name (default "nucleus_sessions")]:value:' \
                        '*:argument:_files'
                    ;;
                collectstatic)
                    _arguments \
                        '--clear[Delete output directory before collecting]' \
                        '--config[Path to nucleus config file]:file:_files' \
                        '--dry-run[Print copy plan without writing files]' \
                        '--no-default-sources[Disable default static source discovery]' \
                        '--output[Destination directory (defaults to config static_root)]:file:_files' \
                        '--source[Comma-separated source directories]:value:' \
                        '*:argument:_files'
                    ;;
                compilemessages)
                    _arguments \
                        '--config[Path to nucleus config file]:file:_files' \
                        '--domain[Messages domain to compile (default "messages")]:value:' \
                        '--dry-run[Print compilation plan without writing files]' \
                        '--locale[Compile only one locale (default - compile all locales)]:value:' \
                        '--locales-path[Locales root path override (defaults to config locales_path)]:file:_files' \
                        '--output[Output .json file path (only when compiling one locale)]:file:_files' \
                        '*:argument:_files'
                    ;;
                completion)
                    _arguments \
                        '1:subcommand:((bash\:"Source the output, or install it under bash-completion'\''s completions directory" zsh\:"Write the output to a file named _nucleus on your fpath, then run compinit" fish\:"Write the output to ~/.config/fish/completions/nucleus.fish"))' \
                        '*:argument:_files'
                    ;;
                config)
                    _files
                    ;;
                createcachetable)
                    _arguments \
                        '--config[Path to nucleus config file]:file:_files' \
                        '--database[Database alias to use (defaults to database_default)]:value:' \
                        '--dry-run[Print SQL and exit without executing]' \
                        '--table[Cache table name (default "nucleus_cache_entries")]:value:' \
                        '*:argument:_files'
                    ;;
                createsuperuser)
                    _arguments \
                        '--config[Path to nucleus config file]:file:_files' \
                        '--database[Database alias to use (defaults to database_default)]:value:' \
                        '--email[Email]:value:' \
                        '--no-input[Disable interactive prompts]' \
                        '--password[Password (plaintext)]:value:' \
                        '--superuser[Create as superuser (default true)]' \
                        '--username[Username]:value:' \
                        '*:argument:_files'
                    ;;
                createuser)
                    _arguments \
                        '--config[Path to nucleus config file]:file:_files' \
                        '--database[Database alias to use (defaults to database_default)]:value:' \
                        '--email[Email]:value:' \
                        '--no-input[Disable interactive prompts]' \
                        '--password[Password (plaintext)]:value:' \
                        '--superuser[Create as superuser (default true)]' \
                        '--username[Username]:value:' \
                        '*:argument:_files'
                    ;;
                dbshell)
                    _arguments \
                        '--c[Shorthand for --command]:value:' \
                        '--command[Execute one SQL command and exit]:value:' \
                        '--config[Path to nucleus config file]:file:_files' \
                        '--database[Database alias to use (defaults to database_default)]:value:' \
                        '--sandbox[Allow only read-only SQL statements]' \
                        '--timeout[Per-statement timeout (default 10s)]:value:' \
                        '*:argument:_files'
                    ;;
                dev)
                    _arguments \
                        '--debounce[How long to wait after the last change before rebuilding (default 300ms)]:value:' \
                        '--dir[Directory of the application'\''s main package; the project is the nearest go.mod at or above it (default ".")]:file:_files' \
                        '--port[Port the application listens on (NUCLEUS_PORT); with --proxy, the port the front listens on. 0 keeps the configured port]:value:' \
                        '--print-routes[Print the routes of the binary (NUCLEUS_PRINT_ROUTES=1) before each start]' \
                        '--proxy[URL of a front-end dev server that answers the --proxy-paths; the command then listens on the port in front of the application]:value:' \
                        '--proxy-paths[Comma-separated request path prefixes forwarded to --proxy (default "/static,/assets")]:value:' \
                        '--routes-timeout[How long the binary may take to print its routes with --print-routes (default 30s)]:value:' \
                        '*:argument:_files'
                    ;;
                diffsettings)
                    _arguments \
                        '--all[Show all settings (including unchanged defaults)]' \
                        '--config[Path to nucleus config file]:file:_files' \
                        '--json[Print output as JSON]' \
                        '*:argument:_files'
                    ;;
                doctor)
                    _arguments \
                        '--check[Specific check to run (default - all)]:value:(tasks outbox storage observability tenancy rbac security auth)' \
                        '--config[Path to nucleus config file]:file:_files' \
                        '--json[Output results as JSON]' \
                        '--verbose[Show detailed output for each check]' \
                        '*:argument:_files'
                    ;;
                dumpdata)
                    _arguments \
                        '--config[Path to nucleus config file]:file:_files' \
                        '--database[Database alias to use (defaults to database_default)]:value:' \
                        '--exclude[Comma-separated table list to exclude]:value:' \
                        '--output[Output JSON file path ('\''-'\'' for stdout) (default "-")]:file:_files' \
                        '--pretty[Pretty-print JSON output (default true)]' \
                        '--tables[Comma-separated table list to export (default - all user tables)]:value:' \
                        '*:argument:_files'
                    ;;
                findstatic)
                    _arguments \
                        '--config[Path to nucleus config file]:file:_files' \
                        '--first[Return only the first match for each query]' \
                        '--json[Print output as JSON]' \
                        '--no-default-sources[Disable default static source discovery]' \
                        '--source[Comma-separated source directories]:value:' \
                        '*:argument:_files'
                    ;;
                flush)
                    _arguments \
                        '--config[Path to nucleus config file]:file:_files' \
                        '--database[Database alias to use (defaults to database_default)]:value:' \
                        '--dry-run[Print generated SQL and exit]' \
                        '--force[Force destructive actions (recommended in CI)]' \
                        '--yes[Auto-confirm destructive actions without prompt]' \
                        '*:argument:_files'
                    ;;
                generate)
                    _arguments \
                        '--config[Path to nucleus config file (defaults to <out>/nucleus.yml)]:file:_files' \
                        '--data[module - storage implementation — sql (database/sql statements for the configured dialect) or quark (the Quark ORM over the managed pool, resolved by the same go mod tidy) (default "sql")]:value:' \
                        '--database[Database alias whose dialect the migration targets (defaults to database_default)]:value:' \
                        '--dialect[Migration SQL dialect (sqlite|postgresql|mysql|mssql|oracle); defaults to the configured database]:value:' \
                        '--force[Overwrite existing files]' \
                        '--migrations[Migrations directory (defaults to <out>/migrations)]:file:_files' \
                        '--mount[module - add the import and the Mount(<name>.Module()) call to the nucleus.New() chain in main.go]' \
                        '--offline[module - do not touch the network — skip the go mod tidy that resolves what the slice and its test import (run it yourself before go test ./...)]' \
                        '--out[Project root output directory (default ".")]:file:_files' \
                        '--with-policy[resource - seed anonymous RBAC rows and a CSRF exemption for the generated routes; module - open every verb to anonymous callers instead of read-only (development defaults)]' \
                        '*:argument:_files'
                    ;;
                health)
                    _arguments \
                        '--config[Path to nucleus config file]:file:_files' \
                        '--deploy[Run additional deployment hardening checks]' \
                        '--json[Print output as JSON]' \
                        '--timeout[Health check timeout (default 3s)]:value:' \
                        '*:argument:_files'
                    ;;
                help)
                    _values 'command' add changepassword check clearsessions collectstatic compilemessages completion config createcachetable createsuperuser createuser dbshell dev diffsettings doctor dumpdata findstatic flush generate health inspectdb loaddata mailproviders makemessages makemigrations migrate new ogrinspect openapi optimizemigration outbox plugin remove_stale_contenttypes routes runserver seed sendtestemail serve shell showmigrations sqlflush sqlmigrate sqlsequencereset squashmigrations startapp startproject test testserver wizard
                    ;;
                inspectdb)
                    _arguments \
                        '--config[Path to nucleus config file]:file:_files' \
                        '--database[Database alias to use (defaults to database_default)]:value:' \
                        '--exclude[Comma-separated table list to exclude]:value:' \
                        '--output[Output Go file path ('\''-'\'' for stdout) (default "-")]:file:_files' \
                        '--package[Go package name for generated structs (default "models")]:value:' \
                        '--tables[Comma-separated table list to inspect (default - all user tables)]:value:' \
                        '*:argument:_files'
                    ;;
                loaddata)
                    _arguments \
                        '--config[Path to nucleus config file]:file:_files' \
                        '--database[Database alias to use (defaults to database_default)]:value:' \
                        '--dry-run[Print loading plan without modifying data]' \
                        '--file[Path to fixture JSON file]:file:_files' \
                        '--force[Force destructive actions (recommended in CI)]' \
                        '--tables[Comma-separated subset of fixture tables to load]:value:' \
                        '--truncate[Truncate target tables before loading fixtures]' \
                        '--yes[Auto-confirm destructive actions without prompt]' \
                        '*:argument:_files'
                    ;;
                mailproviders)
                    _arguments \
                        '--config[Path to nucleus config file]:file:_files' \
                        '--json[Print output as JSON]' \
                        '*:argument:_files'
                    ;;
                makemessages)
                    _arguments \
                        '--config[Path to nucleus config file]:file:_files' \
                        '--domain[Messages domain (file name without extension) (default "messages")]:value:' \
                        '--dry-run[Print extraction summary without writing files]' \
                        '--extensions[Comma-separated file extensions to scan (default ".go,.html,.tmpl,.templ")]:value:' \
                        '--input[Root directory to scan for translatable strings (default ".")]:file:_files' \
                        '--locale[Locale code (defaults to config default_locale)]:value:' \
                        '--locales-path[Locales root path override (defaults to config locales_path)]:file:_files' \
                        '--output[Output .po file path (optional)]:file:_files' \
                        '*:argument:_files'
                    ;;
                makemigrations)
                    _arguments \
                        '--config[Path to nucleus config file]:file:_files' \
                        '--database[Database alias to use (defaults to database_default)]:value:' \
                        '--force[Force destructive actions (recommended in CI)]' \
                        '--migrations[Migrations directory (default "migrations")]:file:_files' \
                        '--yes[Auto-confirm destructive actions without prompt]' \
                        '*:argument:_files'
                    ;;
                migrate)
                    _arguments \
                        '--config[Path to nucleus config file]:file:_files' \
                        '--database[Database alias to use (defaults to database_default)]:value:' \
                        '--force[Force destructive actions (recommended in CI)]' \
                        '--migrations[Migrations directory (default "migrations")]:file:_files' \
                        '--yes[Auto-confirm destructive actions without prompt]' \
                        '1:subcommand:((up\:"Apply every pending migration, or only the next n" down\:"Roll back the last migration, or the last n (destructive - --force or --yes in production)" steps\:"Apply n migrations forward, or roll back |n| when n is negative" status\:"List every migration file with its applied/pending state" drift\:"Report applied migrations whose .up.sql file is missing on disk; exits non-zero on drift" reset\:"Roll back every applied migration (destructive)" refresh\:"Roll back every applied migration, then apply all of them again (destructive)" create\:"Write an empty <timestamp>_<name>.up.sql/.down.sql pair; needs no database"))' \
                        '*:argument:_files'
                    ;;
                new)
                    _arguments \
                        '--db[Database engine the project starts on (sqlite, postgres, mysql, sqlserver, oracle) - its driver module is required and imported (default "sqlite")]:value:(sqlite postgres mysql sqlserver oracle)' \
                        '--force[Overwrite scaffold files if the project directory exists]' \
                        '--module[Go module path (default - example.com/<project_name>)]:value:' \
                        '--offline[Do not touch the network - skip the go get of the driver and suite modules and the go mod tidy (run them yourself before go run .)]' \
                        '--out[Parent directory where the project folder will be created (default ".")]:file:_files' \
                        '--port[HTTP port in nucleus.yml (default 8080)]:value:' \
                        '--template[Starter template (mvc - full-stack, api - lightweight core-only, suite - Nucleus + Quark + Orbit wired together) (default "mvc")]:value:(mvc api suite)' \
                        '--with[Suite modules to fetch and wire, comma-separated (orbit, quark, quarkbridge, quarkdatasource); --template suite implies all four]:value:' \
                        '*:argument:_files'
                    ;;
                ogrinspect)
                    _arguments \
                        '--all[Include non-geospatial tables (default - geospatial tables only)]' \
                        '--config[Path to nucleus config file]:file:_files' \
                        '--database[Database alias to use (defaults to database_default)]:value:' \
                        '--exclude[Comma-separated table list to exclude]:value:' \
                        '--output[Output Go file path ('\''-'\'' for stdout) (default "-")]:file:_files' \
                        '--package[Go package name for generated structs (default "models")]:value:' \
                        '--tables[Comma-separated table list to inspect (default - all user tables)]:value:' \
                        '*:argument:_files'
                    ;;
                openapi)
                    _arguments \
                        '--out[Output path for the exported OpenAPI JSON document, or - for stdout (default "openapi.json")]:file:_files' \
                        '--project[Project root that contains go.mod and internal/contracts (default ".")]:file:_files' \
                        '*:argument:_files'
                    ;;
                optimizemigration)
                    _arguments \
                        '--down[Optimize rollback SQL (.down.sql) instead of apply SQL (.up.sql)]' \
                        '--migrations[Migrations directory (default "migrations")]:file:_files' \
                        '--write[Write optimized SQL back to the migration file]' \
                        '*:argument:_files'
                    ;;
                outbox)
                    _files
                    ;;
                plugin)
                    _files
                    ;;
                remove_stale_contenttypes)
                    _arguments \
                        '--column[Column storing model/table names (default "model")]:value:' \
                        '--config[Path to nucleus config file]:file:_files' \
                        '--database[Database alias to use (defaults to database_default)]:value:' \
                        '--dry-run[Print SQL and stale entries without deleting]' \
                        '--force[Force destructive actions (recommended in CI)]' \
                        '--keep[Comma-separated model names to keep even if table is missing]:value:' \
                        '--table[Content types table name (default "nucleus_content_types")]:value:' \
                        '--yes[Auto-confirm destructive actions without prompt]' \
                        '*:argument:_files'
                    ;;
                routes)
                    _arguments \
                        '--config[Path to nucleus config file (configuration-only listing; your binary reads its own)]:file:_files' \
                        '--dir[Directory of the application'\''s main package; the project is the nearest go.mod at or above it (default ".")]:file:_files' \
                        '--framework-only[List the framework'\''s own routes from configuration without building or running the application]' \
                        '--json[Print routes as JSON]' \
                        '--path[Filter routes by prefix]:file:_files' \
                        '--timeout[How long the built application may take to print its routes before it is killed (the build is not counted) (default 30s)]:value:' \
                        '--verbose[Include middleware count]' \
                        '*:argument:_files'
                    ;;
                runserver)
                    _arguments \
                        '--config[Path to nucleus config file]:file:_files' \
                        '--host[Override host]:value:' \
                        '--port[Override port]:value:' \
                        '--without-defaults[Serve a core-only app without the default subsystems (admin, authz, mail, storage), matching what an api scaffold'\''s go run . starts]' \
                        '*:argument:_files'
                    ;;
                seed)
                    _arguments \
                        '--config[Path to nucleus config file]:file:_files' \
                        '--database[Database alias to use (defaults to database_default)]:value:' \
                        '--dry-run[Print seed execution plan without running SQL]' \
                        '--file[Run a single seed file (absolute path or relative to --seeds)]:file:_files' \
                        '--force[Force seed execution in production/CI]' \
                        '--seeds[Directory containing .sql seed files (default "seeds")]:file:_files' \
                        '--yes[Auto-confirm seed execution without prompt]' \
                        '*:argument:_files'
                    ;;
                sendtestemail)
                    _arguments \
                        '--body[Email body (default "This is a test email sent by nucleus sendtestemail.")]:value:' \
                        '--config[Path to nucleus config file]:file:_files' \
                        '--driver[Mail driver override (defaults to config mail_driver)]:value:' \
                        '--dry-run[Print send plan without contacting the mail provider]' \
                        '--from[Sender email (defaults to config mail_from)]:value:' \
                        '--subject[Subject line (default "Nucleus test email")]:value:' \
                        '--timeout[Mail provider operation timeout (default 10s)]:value:' \
                        '--to[Comma-separated recipient emails]:value:' \
                        '*:argument:_files'
                    ;;
                serve)
                    _arguments \
                        '--config[Path to nucleus config file]:file:_files' \
                        '--host[Override host]:value:' \
                        '--port[Override port]:value:' \
                        '--without-defaults[Serve a core-only app without the default subsystems (admin, authz, mail, storage), matching what an api scaffold'\''s go run . starts]' \
                        '*:argument:_files'
                    ;;
                shell)
                    _arguments \
                        '--c[Shorthand for --command]:value:' \
                        '--command[Execute one SQL command and exit]:value:' \
                        '--config[Path to nucleus config file]:file:_files' \
                        '--database[Database alias to use (defaults to database_default)]:value:' \
                        '--sandbox[Allow only read-only SQL statements]' \
                        '--timeout[Per-statement timeout (default 10s)]:value:' \
                        '*:argument:_files'
                    ;;
                showmigrations)
                    _arguments \
                        '--config[Path to nucleus config file]:file:_files' \
                        '--database[Database alias to use (defaults to database_default)]:value:' \
                        '--force[Force destructive actions (recommended in CI)]' \
                        '--migrations[Migrations directory (default "migrations")]:file:_files' \
                        '--yes[Auto-confirm destructive actions without prompt]' \
                        '*:argument:_files'
                    ;;
                sqlflush)
                    _arguments \
                        '--config[Path to nucleus config file]:file:_files' \
                        '--database[Database alias to use (defaults to database_default)]:value:' \
                        '*:argument:_files'
                    ;;
                sqlmigrate)
                    _arguments \
                        '--down[Print rollback SQL (.down.sql) instead of apply SQL (.up.sql)]' \
                        '--migrations[Migrations directory (default "migrations")]:file:_files' \
                        '*:argument:_files'
                    ;;
                sqlsequencereset)
                    _arguments \
                        '--config[Path to nucleus config file]:file:_files' \
                        '--database[Database alias to use (defaults to database_default)]:value:' \
                        '*:argument:_files'
                    ;;
                squashmigrations)
                    _arguments \
                        '--archive-old[Move source migrations to migrations/.squashed/<new_id>/ after writing]' \
                        '--dry-run[Print squash plan without writing files]' \
                        '--force[Overwrite output files if they already exist]' \
                        '--from[First migration in squash range (inclusive)]:value:' \
                        '--migrations[Migrations directory (default "migrations")]:file:_files' \
                        '--name[Squashed migration name (default - squashed_<from>_to_<to>)]:value:' \
                        '--print-sql[Print generated up/down SQL in dry-run mode]' \
                        '--to[Last migration in squash range (inclusive)]:value:' \
                        '--write[Write squashed migration files]' \
                        '*:argument:_files'
                    ;;
                startapp)
                    _arguments \
                        '--config[Path to nucleus config file (defaults to <out>/nucleus.yml)]:file:_files' \
                        '--database[Database alias whose dialect the migration targets (defaults to database_default)]:value:' \
                        '--dialect[Migration SQL dialect (sqlite|postgresql|mysql|mssql|oracle); defaults to the configured database]:value:' \
                        '--force[Overwrite existing files]' \
                        '--migrations[Migrations directory (defaults to <out>/migrations)]:file:_files' \
                        '--out[Project root output directory (default ".")]:file:_files' \
                        '--skip-migration[Skip SQL migration scaffold generation]' \
                        '*:argument:_files'
                    ;;
                startproject)
                    _arguments \
                        '--db[Database engine the project starts on (sqlite, postgres, mysql, sqlserver, oracle) - its driver module is required and imported (default "sqlite")]:value:(sqlite postgres mysql sqlserver oracle)' \
                        '--force[Overwrite scaffold files if the project directory exists]' \
                        '--module[Go module path (default - example.com/<project_name>)]:value:' \
                        '--offline[Do not touch the network - skip the go get of the driver and suite modules and the go mod tidy (run them yourself before go run .)]' \
                        '--out[Parent directory where the project folder will be created (default ".")]:file:_files' \
                        '--port[HTTP port in nucleus.yml (default 8080)]:value:' \
                        '--template[Starter template (mvc - full-stack, api - lightweight core-only, suite - Nucleus + Quark + Orbit wired together) (default "mvc")]:value:(mvc api suite)' \
                        '--with[Suite modules to fetch and wire, comma-separated (orbit, quark, quarkbridge, quarkdatasource); --template suite implies all four]:value:' \
                        '*:argument:_files'
                    ;;
                test)
                    _arguments \
                        '--count[Run each test and benchmark n times (default 1)]:value:' \
                        '--cover[Enable coverage reporting]' \
                        '--dry-run[Print generated go test command without executing it]' \
                        '--failfast[Stop after first test failure]' \
                        '--race[Enable race detector]' \
                        '--run[Run only tests matching the regex]:value:' \
                        '--timeout[Set go test timeout (e.g. 60s)]:value:' \
                        '*:argument:_files'
                    ;;
                testserver)
                    _arguments \
                        '--config[Path to nucleus config file]:file:_files' \
                        '--dry-run[Run fixture load plan and skip server startup]' \
                        '--fixture[Path to fixture JSON file]:file:_files' \
                        '--force[Force destructive actions (recommended in CI)]' \
                        '--host[Override host]:value:' \
                        '--port[Override port]:value:' \
                        '--tables[Comma-separated subset of fixture tables to load]:value:' \
                        '--truncate[Truncate fixture tables before loading (default true)]' \
                        '--yes[Auto-confirm destructive actions without prompt]' \
                        '*:argument:_files'
                    ;;
                version)
                    _files
                    ;;
                wizard)
                    _arguments \
                        '--config[Path to nucleus config file]:file:_files' \
                        '--type[Wizard type - inspectdb, new, startapp]:value:' \
                        '*:argument:_files'
                    ;;
            esac
            ;;
    esac
}

_nucleus "$@"
