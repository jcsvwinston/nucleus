# nucleus bash completion, generated by `nucleus completion bash`. Do not edit: regenerate after upgrading the CLI.
_nucleus_completion() {
    local cur prev cmd i
    COMPREPLY=()
    cur="${COMP_WORDS[COMP_CWORD]}"
    prev="${COMP_WORDS[COMP_CWORD-1]}"
    cmd=""
    for ((i = 1; i < COMP_CWORD; i++)); do
        case "${COMP_WORDS[i]}" in
            --output|-output) ((i++)) ;;
            --color|-color) ((i++)) ;;
            -*) ;;
            *) cmd="${COMP_WORDS[i]}"; break ;;
        esac
    done
    if [[ -z "$cmd" ]]; then
        case "$prev" in
            --output|-output) COMPREPLY=($(compgen -W "plain pretty json" -- "$cur")); return ;;
            --color|-color) COMPREPLY=($(compgen -W "auto always never" -- "$cur")); return ;;
        esac
        if [[ "$cur" == -* ]]; then
            COMPREPLY=($(compgen -W "--output --color --symbols --no-symbols --json" -- "$cur"))
            return
        fi
        COMPREPLY=($(compgen -W "add changepassword check clearsessions collectstatic compilemessages completion config createcachetable createsuperuser createuser dbshell dev diffsettings doctor dumpdata findstatic flush generate health help inspectdb loaddata mailproviders makemessages makemigrations migrate new ogrinspect openapi optimizemigration outbox plugin remove_stale_contenttypes routes runserver seed sendtestemail serve shell showmigrations sqlflush sqlmigrate sqlsequencereset squashmigrations startapp startproject test testserver version wizard" -- "$cur"))
        return
    fi
    case "$cmd" in
        add)
            return ;;
        changepassword)
            if [[ "$cur" == -* ]]; then
                COMPREPLY=($(compgen -W "--config --database --no-input --password --username" -- "$cur"))
                return
            fi
            return ;;
        check)
            if [[ "$cur" == -* ]]; then
                COMPREPLY=($(compgen -W "--config --deploy --json --timeout" -- "$cur"))
                return
            fi
            return ;;
        clearsessions)
            if [[ "$cur" == -* ]]; then
                COMPREPLY=($(compgen -W "--all --config --database --dry-run --table" -- "$cur"))
                return
            fi
            return ;;
        collectstatic)
            if [[ "$cur" == -* ]]; then
                COMPREPLY=($(compgen -W "--clear --config --dry-run --no-default-sources --output --source" -- "$cur"))
                return
            fi
            return ;;
        compilemessages)
            if [[ "$cur" == -* ]]; then
                COMPREPLY=($(compgen -W "--config --domain --dry-run --locale --locales-path --output" -- "$cur"))
                return
            fi
            return ;;
        completion)
            COMPREPLY=($(compgen -W "bash zsh fish" -- "$cur"))
            return ;;
        config)
            return ;;
        createcachetable)
            if [[ "$cur" == -* ]]; then
                COMPREPLY=($(compgen -W "--config --database --dry-run --table" -- "$cur"))
                return
            fi
            return ;;
        createsuperuser)
            if [[ "$cur" == -* ]]; then
                COMPREPLY=($(compgen -W "--config --database --email --no-input --password --superuser --username" -- "$cur"))
                return
            fi
            return ;;
        createuser)
            if [[ "$cur" == -* ]]; then
                COMPREPLY=($(compgen -W "--config --database --email --no-input --password --superuser --username" -- "$cur"))
                return
            fi
            return ;;
        dbshell)
            if [[ "$cur" == -* ]]; then
                COMPREPLY=($(compgen -W "--c --command --config --database --sandbox --timeout" -- "$cur"))
                return
            fi
            return ;;
        dev)
            if [[ "$cur" == -* ]]; then
                COMPREPLY=($(compgen -W "--debounce --dir --port --print-routes --proxy --proxy-paths --routes-timeout" -- "$cur"))
                return
            fi
            return ;;
        diffsettings)
            if [[ "$cur" == -* ]]; then
                COMPREPLY=($(compgen -W "--all --config --json" -- "$cur"))
                return
            fi
            return ;;
        doctor)
            case "$prev" in
                --check|-check) COMPREPLY=($(compgen -W "tasks outbox storage observability tenancy rbac security auth image" -- "$cur")); return ;;
            esac
            if [[ "$cur" == -* ]]; then
                COMPREPLY=($(compgen -W "--check --config --json --verbose" -- "$cur"))
                return
            fi
            return ;;
        dumpdata)
            if [[ "$cur" == -* ]]; then
                COMPREPLY=($(compgen -W "--config --database --exclude --output --pretty --tables" -- "$cur"))
                return
            fi
            return ;;
        findstatic)
            if [[ "$cur" == -* ]]; then
                COMPREPLY=($(compgen -W "--config --first --json --no-default-sources --source" -- "$cur"))
                return
            fi
            return ;;
        flush)
            if [[ "$cur" == -* ]]; then
                COMPREPLY=($(compgen -W "--config --database --dry-run --force --yes" -- "$cur"))
                return
            fi
            return ;;
        generate)
            if [[ "$cur" == -* ]]; then
                COMPREPLY=($(compgen -W "--config --data --database --dialect --force --migrations --mount --offline --out --with-policy" -- "$cur"))
                return
            fi
            return ;;
        health)
            if [[ "$cur" == -* ]]; then
                COMPREPLY=($(compgen -W "--config --deploy --json --timeout" -- "$cur"))
                return
            fi
            return ;;
        help)
            COMPREPLY=($(compgen -W "add changepassword check clearsessions collectstatic compilemessages completion config createcachetable createsuperuser createuser dbshell dev diffsettings doctor dumpdata findstatic flush generate health inspectdb loaddata mailproviders makemessages makemigrations migrate new ogrinspect openapi optimizemigration outbox plugin remove_stale_contenttypes routes runserver seed sendtestemail serve shell showmigrations sqlflush sqlmigrate sqlsequencereset squashmigrations startapp startproject test testserver wizard" -- "$cur"))
            return ;;
        inspectdb)
            if [[ "$cur" == -* ]]; then
                COMPREPLY=($(compgen -W "--config --database --exclude --output --package --tables" -- "$cur"))
                return
            fi
            return ;;
        loaddata)
            if [[ "$cur" == -* ]]; then
                COMPREPLY=($(compgen -W "--config --database --dry-run --file --force --tables --truncate --yes" -- "$cur"))
                return
            fi
            return ;;
        mailproviders)
            if [[ "$cur" == -* ]]; then
                COMPREPLY=($(compgen -W "--config --json" -- "$cur"))
                return
            fi
            return ;;
        makemessages)
            if [[ "$cur" == -* ]]; then
                COMPREPLY=($(compgen -W "--config --domain --dry-run --extensions --input --locale --locales-path --output" -- "$cur"))
                return
            fi
            return ;;
        makemigrations)
            if [[ "$cur" == -* ]]; then
                COMPREPLY=($(compgen -W "--config --database --force --migrations --yes" -- "$cur"))
                return
            fi
            return ;;
        migrate)
            if [[ "$cur" == -* ]]; then
                COMPREPLY=($(compgen -W "--config --database --force --migrations --yes" -- "$cur"))
                return
            fi
            COMPREPLY=($(compgen -W "up down steps status drift reset refresh create" -- "$cur"))
            return ;;
        new)
            case "$prev" in
                --db|-db) COMPREPLY=($(compgen -W "sqlite postgres mysql sqlserver oracle" -- "$cur")); return ;;
                --template|-template) COMPREPLY=($(compgen -W "mvc api suite" -- "$cur")); return ;;
            esac
            if [[ "$cur" == -* ]]; then
                COMPREPLY=($(compgen -W "--db --force --module --offline --out --port --template --with" -- "$cur"))
                return
            fi
            return ;;
        ogrinspect)
            if [[ "$cur" == -* ]]; then
                COMPREPLY=($(compgen -W "--all --config --database --exclude --output --package --tables" -- "$cur"))
                return
            fi
            return ;;
        openapi)
            if [[ "$cur" == -* ]]; then
                COMPREPLY=($(compgen -W "--out --project" -- "$cur"))
                return
            fi
            return ;;
        optimizemigration)
            if [[ "$cur" == -* ]]; then
                COMPREPLY=($(compgen -W "--down --migrations --write" -- "$cur"))
                return
            fi
            return ;;
        outbox)
            return ;;
        plugin)
            return ;;
        remove_stale_contenttypes)
            if [[ "$cur" == -* ]]; then
                COMPREPLY=($(compgen -W "--column --config --database --dry-run --force --keep --table --yes" -- "$cur"))
                return
            fi
            return ;;
        routes)
            if [[ "$cur" == -* ]]; then
                COMPREPLY=($(compgen -W "--config --dir --framework-only --json --path --timeout --verbose" -- "$cur"))
                return
            fi
            return ;;
        runserver)
            if [[ "$cur" == -* ]]; then
                COMPREPLY=($(compgen -W "--config --host --port --without-defaults" -- "$cur"))
                return
            fi
            return ;;
        seed)
            if [[ "$cur" == -* ]]; then
                COMPREPLY=($(compgen -W "--config --database --dry-run --file --force --seeds --yes" -- "$cur"))
                return
            fi
            return ;;
        sendtestemail)
            if [[ "$cur" == -* ]]; then
                COMPREPLY=($(compgen -W "--body --config --driver --dry-run --from --subject --timeout --to" -- "$cur"))
                return
            fi
            return ;;
        serve)
            if [[ "$cur" == -* ]]; then
                COMPREPLY=($(compgen -W "--config --host --port --without-defaults" -- "$cur"))
                return
            fi
            return ;;
        shell)
            if [[ "$cur" == -* ]]; then
                COMPREPLY=($(compgen -W "--c --command --config --database --sandbox --timeout" -- "$cur"))
                return
            fi
            return ;;
        showmigrations)
            if [[ "$cur" == -* ]]; then
                COMPREPLY=($(compgen -W "--config --database --force --migrations --yes" -- "$cur"))
                return
            fi
            return ;;
        sqlflush)
            if [[ "$cur" == -* ]]; then
                COMPREPLY=($(compgen -W "--config --database" -- "$cur"))
                return
            fi
            return ;;
        sqlmigrate)
            if [[ "$cur" == -* ]]; then
                COMPREPLY=($(compgen -W "--down --migrations" -- "$cur"))
                return
            fi
            return ;;
        sqlsequencereset)
            if [[ "$cur" == -* ]]; then
                COMPREPLY=($(compgen -W "--config --database" -- "$cur"))
                return
            fi
            return ;;
        squashmigrations)
            if [[ "$cur" == -* ]]; then
                COMPREPLY=($(compgen -W "--archive-old --dry-run --force --from --migrations --name --print-sql --to --write" -- "$cur"))
                return
            fi
            return ;;
        startapp)
            if [[ "$cur" == -* ]]; then
                COMPREPLY=($(compgen -W "--config --database --dialect --force --migrations --out --skip-migration" -- "$cur"))
                return
            fi
            return ;;
        startproject)
            case "$prev" in
                --db|-db) COMPREPLY=($(compgen -W "sqlite postgres mysql sqlserver oracle" -- "$cur")); return ;;
                --template|-template) COMPREPLY=($(compgen -W "mvc api suite" -- "$cur")); return ;;
            esac
            if [[ "$cur" == -* ]]; then
                COMPREPLY=($(compgen -W "--db --force --module --offline --out --port --template --with" -- "$cur"))
                return
            fi
            return ;;
        test)
            if [[ "$cur" == -* ]]; then
                COMPREPLY=($(compgen -W "--count --cover --dry-run --failfast --race --run --timeout" -- "$cur"))
                return
            fi
            return ;;
        testserver)
            if [[ "$cur" == -* ]]; then
                COMPREPLY=($(compgen -W "--config --dry-run --fixture --force --host --port --tables --truncate --yes" -- "$cur"))
                return
            fi
            return ;;
        version)
            return ;;
        wizard)
            if [[ "$cur" == -* ]]; then
                COMPREPLY=($(compgen -W "--config --type" -- "$cur"))
                return
            fi
            return ;;
    esac
}
complete -o default -F _nucleus_completion nucleus
