# Only the framework module and the CLI's (cmd/nucleus, a module of its own)
# reach the builder: the sibling modules, the examples (their own modules),
# the site and the docs are not inputs to `go build ./cmd/nucleus` — the CLI
# takes its driver modules from the versions it requires — and without this
# list `COPY . .` shipped website/node_modules and .git into every build
# context.
.git
.github
.claude
.tmp
.cache
dist
website
docs
examples
drivers
exporters
providers
*.db
*.db-journal
*.log
docker-compose*.yml
Dockerfile
nginx.conf
internal/testdeps
go.work
go.work.sum
